# =================================================================
# x402 Level 2 极端环境生存决策系统 —— 客户端 (Agent) 环境变量配置
# 【安全铁律】付款私钥仅存放于客户端本地，严禁上传 GitHub，严禁泄露给服务端！
# =================================================================

# 付款方私钥 (64 位 16 进制字符串，前缀 0x 可有可无)
PAYER_PRIVATE_KEY=your_private_key_here

# 预期的服务端收款钱包地址 (用于验证 402 账单是否被中间人篡改)
EXPECTED_PAY_TO=0xdcD7DAFafb0EF3d50bDdB480Dbd503Fa6D1B6C09

# 目标服务端地址 (支持云端直接调用或本地调试)：
# - 官方在线 Vercel 云端：https://x402-survival-l2a-server.vercel.app (开箱即用，无需本地开服务器)
# - 本地开发调试：http://localhost:3000
TARGET_URL=https://x402-survival-l2a-server.vercel.app

# 默认探险测试目标（经纬度或地名）
EXPEDITION_LAT=38.0
EXPEDITION_LON=88.5
EXPEDITION_LOCATION=阿尔金山无人区
EXPEDITION_PROFILE=desert_wilderness_traverse
